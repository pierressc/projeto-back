@startuml diagrama-classes-dominio
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 6

title Diagrama de Classes - Central de Encomendas

package "cliente.entity" {
    class Cliente {
        - id : Long
        - nome : String
        - telefone : String
        - email : String
        - observacoes : String
        --
        + atualizarContato(nome : String, telefone : String, email : String) : void
        + atualizarObservacoes(observacoes : String) : void
    }
}

package "colaborador.entity" {
    class Colaborador {
        - id : Long
        - nome : String
        - email : String
        - setor : SetorColaborador
        - ativo : boolean
        --
        + atualizarDados(nome : String, email : String) : void
        + alterarSetor(novoSetor : SetorColaborador) : void
        + ativar() : void
        + desativar() : void
    }
}

package "encomenda.entity" {
    class Encomenda {
        - id : Long
        - codigo : String
        - canalOrigem : CanalOrigem
        - status : StatusEncomenda
        - dataPedido : LocalDateTime
        - dataPrazoEntrega : LocalDate
        - dataEntregaRealizada : LocalDateTime
        - tipoEntrega : TipoEntrega
        - enderecoEntrega : String
        - valorTotal : BigDecimal
        - valorSinalExigido : BigDecimal
        - observacoes : String
        --
        + adicionarItem(descricaoProduto : String, personalizacao : String, quantidade : int, valorUnitario : BigDecimal) : ItemEncomenda
        + removerItem(item : ItemEncomenda) : void
        + adicionarMaterial(nome : String, quantidade : String, observacao : String) : MaterialEncomenda
        + confirmarCompraMaterial(material : MaterialEncomenda) : void
        + registrarPagamento(valor : BigDecimal, forma : FormaPagamento, responsavel : Colaborador, observacao : String) : Pagamento
        + liberarParaProducao() : void
        + solicitarAlteracao(descricaoMudanca : String, custoAdicional : BigDecimal, solicitante : Colaborador) : SolicitacaoAlteracao
        + aprovarAlteracao(solicitacao : SolicitacaoAlteracao, avaliador : Colaborador, custoExtraConfirmado : BigDecimal, motivo : String) : void
        + recusarAlteracao(solicitacao : SolicitacaoAlteracao, avaliador : Colaborador, motivo : String) : void
        + marcarComoPronto() : void
        + concluirEntrega() : void
        + cancelar(motivo : String) : void
        + calcularTotalPago() : BigDecimal
        + calcularSaldoAReceber() : BigDecimal
        + sinalEstaPago() : boolean
        + todosMateriaisComprados() : boolean
    }

    class ItemEncomenda {
        - id : Long
        - descricaoProduto : String
        - personalizacao : String
        - quantidade : int
        - valorUnitario : BigDecimal
        --
        + calcularSubtotal() : BigDecimal
    }

    class MaterialEncomenda {
        - id : Long
        - nome : String
        - quantidade : String
        - observacao : String
        - comprado : boolean
        --
        + marcarComoComprado() : void
    }
}

package "pagamento.entity" {
    class Pagamento {
        - id : Long
        - valor : BigDecimal
        - forma : FormaPagamento
        - dataPagamento : LocalDateTime
        - observacao : String
    }
}

package "solicitacaoalteracao.entity" {
    class SolicitacaoAlteracao {
        - id : Long
        - descricaoMudanca : String
        - custoAdicional : BigDecimal
        - status : StatusSolicitacaoAlteracao
        - dataSolicitacao : LocalDateTime
        - dataResposta : LocalDateTime
        - motivoResposta : String
        --
        + aprovar(avaliador : Colaborador, custoExtraConfirmado : BigDecimal, motivoResposta : String) : void
        + recusar(avaliador : Colaborador, motivoResposta : String) : void
        + isPendente() : boolean
    }
}

package "shared.enums" {
    enum CanalOrigem {
        WHATSAPP
        INSTAGRAM
        PRESENCIAL
    }
    enum SetorColaborador {
        ATENDIMENTO
        PRODUCAO
        ADMINISTRACAO
        ENTREGA
    }
    enum StatusEncomenda {
        AGUARDANDO_SINAL_MATERIAL
        EM_PRODUCAO
        PRONTO
        ENTREGUE
        CANCELADO
    }
    enum FormaPagamento {
        PIX
        CARTAO_CREDITO
        CARTAO_DEBITO
        DINHEIRO
        TRANSFERENCIA
    }
    enum StatusSolicitacaoAlteracao {
        PENDENTE
        APROVADA
        RECUSADA
    }
    enum TipoEntrega {
        RETIRADA_LOJA
        ENTREGA_DOMICILIO
    }
}

Cliente "1" -- "0..*" Encomenda : realiza >
Encomenda "0..*" --> "1" Colaborador : atendente

Encomenda "1" *-- "0..*" ItemEncomenda : itens
Encomenda "1" *-- "0..*" MaterialEncomenda : materiais
Encomenda "1" *-- "0..*" Pagamento : pagamentos
Encomenda "1" *-- "0..*" SolicitacaoAlteracao : alteracoes

Pagamento "0..*" --> "1" Colaborador : registradoPor
SolicitacaoAlteracao "0..*" --> "1" Colaborador : solicitante
SolicitacaoAlteracao "0..*" --> "0..1" Colaborador : avaliador

@enduml
